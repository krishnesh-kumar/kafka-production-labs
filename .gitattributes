# Keep LF endings in the repo and in checkouts, including on Windows: bash, compose and the
# container entrypoints fail on CRLF.
* text=auto
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
*.png  binary
